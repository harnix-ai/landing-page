# Canonical origin — used for metadataBase and the OG card URL.
NEXT_PUBLIC_SITE_URL=https://harnix.vn

# Pricing section, its nav item ("Từ 2,9 triệu/tháng") and footer link.
# Off until the pricing model is settled — the design is kept intact in
# components/sections/pricing.tsx; set to "true" to show it.
NEXT_PUBLIC_PRICING_ENABLED=

# "Hỏi Harnix" chat launcher. UI only (no answers yet) — keep off until a
# real chatbot is wired in.
NEXT_PUBLIC_CHAT_ENABLED=

# Hero video. Defaults to "ready" (falls back to the two URLs below);
# set to "coming-soon" to show the pill + notify CTA instead.
NEXT_PUBLIC_DEMO_STATUS=ready
NEXT_PUBLIC_DEMO_VIDEO_URL_VI=https://s3.lequoctrung.id.vn/harnix/harnix-film-vi-web.mp4
NEXT_PUBLIC_DEMO_VIDEO_URL_EN=https://s3.lequoctrung.id.vn/harnix/harnix-film-web.mp4
NEXT_PUBLIC_DEMO_POSTER_URL_VI=https://s3.lequoctrung.id.vn/harnix/harnix-film-vi-poster.png
NEXT_PUBLIC_DEMO_POSTER_URL_EN=https://s3.lequoctrung.id.vn/harnix/harnix-film-poster.png
NEXT_PUBLIC_DEMO_TRANSCRIPT_URL=

# Docs site — a static export built from harnix-ai/harnix (docs-site/) and
# served by a Cloudflare Worker; proxied in at /docs via the rewrite in
# next.config.ts. DOCS_ORIGIN is the Worker origin, no path, no trailing
# slash (e.g. https://harnix-docs.le-quoc-trung.workers.dev); without it the
# /docs rewrite is skipped entirely. Docs URLs keep their trailing slash
# (/docs/x/) — see skipTrailingSlashRedirect in next.config.ts and proxy.ts.
# NEXT_PUBLIC_DOCS_URL_VI/EN are the header/footer link targets ("/docs",
# "/docs/en") — leave empty to keep those links inert.
DOCS_ORIGIN=
NEXT_PUBLIC_DOCS_URL_VI=
NEXT_PUBLIC_DOCS_URL_EN=

# Footer social links. Empty renders the label as muted, non-clickable text
# (LinkedIn falls back to https://www.linkedin.com/company/harnix-ai).
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GITHUB_URL=

# Server-only. Where demo-request (partner.submitted) and waitlist leads are
# POSTed as JSON — the Apps Script that writes the leads Sheet. Unset means
# submissions are logged server-side and still succeed.
# partner.submitted payload: name, phone, email, company, size, want
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# GA4 measurement ID ("G-XXXXXXXXXX"). Empty skips loading gtag entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
