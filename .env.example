# Canonical origin — used for metadataBase and the OG card URL.
NEXT_PUBLIC_SITE_URL=https://harnix.vn

# Hero status pill: "Đang xây dựng · M1"
NEXT_PUBLIC_MILESTONE=M1

# Demo section. "coming-soon" shows the pill + notify CTA; "ready" shows the
# play button, real chapter timestamps, and the transcript link.
NEXT_PUBLIC_DEMO_STATUS=coming-soon
NEXT_PUBLIC_DEMO_MINUTES=3
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DEMO_TRANSCRIPT_URL=

# Integration docs. Empty keeps the link inert, as the design specifies.
NEXT_PUBLIC_DOCS_URL=

# Footer social links. Empty renders the label as muted, non-clickable text.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GITHUB_URL=

# Server-only. Where design-partner and waitlist submissions are POSTed as
# JSON. Unset means submissions are logged server-side and still succeed.
LEADS_WEBHOOK_URL=

# GA4 measurement ID ("G-XXXXXXXXXX"). Empty skips loading gtag entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
